# ─────────────────────────────────────────────────────────────
# HELIX — Environment Variables
# Copy to .env (never commit .env). All credentials required for
# the agent to execute a full mission end-to-end.
# ─────────────────────────────────────────────────────────────

# ── Google Cloud / Vertex AI / Gemini ────────────────────────
GOOGLE_CLOUD_PROJECT=listing-agent-hackathon
GOOGLE_CLOUD_LOCATION=us-central1
# Path to service account JSON key (used locally; in prod use ADC)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json
# Gemini model id — pin to 3 family
GEMINI_MODEL=gemini-3-pro
# Embedding model for operational memory
EMBEDDING_MODEL=text-embedding-004

# ── Vertex AI Agent Builder ──────────────────────────────────
# The agent's resource id once deployed via ADK
VERTEX_AGENT_ID=
VERTEX_AGENT_ENDPOINT=

# ── MongoDB Atlas ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/helix?retryWrites=true&w=majority
MONGODB_DB=helix
# Atlas Vector Search index name (created on listings_memory.embedding)
MONGODB_VECTOR_INDEX=listings_vector_idx

# ── MongoDB MCP Server ───────────────────────────────────────
# Required for hackathon qualification — exposed to the agent as a tool
MONGODB_MCP_URL=
MONGODB_MCP_API_KEY=

# ── Shopify (Dev Store) ──────────────────────────────────────
SHOPIFY_STORE_DOMAIN=helix-dev.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01

# ── Backend (FastAPI) ────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS
FRONTEND_ORIGIN=http://localhost:3000

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Public Mongo connection for change-stream listener (read-only DB user)
NEXT_PUBLIC_MONGODB_REALM_APP_ID=

# ── Optional: web search grounding (if not using Gemini grounding native) ──
TAVILY_API_KEY=
